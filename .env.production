# FinapticoOS Sprint 0 Bloque 2 — defensa en profundidad telemetría off.
# La carpeta packages/shared/src/telemetry/ ya fue eliminada y sustituida por un
# stub no-op, asi que estos flags son una capa adicional por si un rebase
# upstream futuro reintroduce la implementacion: resolveTelemetryConfig original
# respeta ambas variables.
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
