{
  "name": "@finapticoos/bridge",
  "version": "0.1.0",
  "description": "Read-only bridge from FinapticoOS to the Finaptico CRM (crm.prospects, crm.meetings, crm.interactions). Plan Sprint 0 Bloque 7a — zero state duplication, on-demand reads.",
  "license": "MIT",
  "homepage": "https://github.com/Shatzilie/finapticoos",
  "bugs": {
    "url": "https://github.com/Shatzilie/finapticoos/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shatzilie/finapticoos",
    "directory": "packages/finaptico-bridge"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
